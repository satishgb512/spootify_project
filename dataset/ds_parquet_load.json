{
	"name": "ds_parquet_load",
	"properties": {
		"linkedServiceName": {
			"referenceName": "adls_ls",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"table_nm": {
				"type": "string"
			}
		},
		"annotations": [],
		"type": "Parquet",
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"folderPath": {
					"value": "@concat(\n    dataset().table_nm,\n    '/',\n    formatDateTime(utcnow(), 'yyyy'),\n    '/',\n    formatDateTime(utcnow(), 'MM'),\n    '/',\n    formatDateTime(utcnow(), 'dd'),\n    '/',\n    formatDateTime(utcnow(), 'HH')\n)",
					"type": "Expression"
				},
				"fileSystem": "bronze"
			},
			"compressionCodec": "snappy"
		},
		"schema": [
			{
				"name": "track_id",
				"type": "INT32"
			},
			{
				"name": "track_name",
				"type": "UTF8"
			},
			{
				"name": "artist_id",
				"type": "INT32"
			},
			{
				"name": "album_name",
				"type": "UTF8"
			},
			{
				"name": "duration_sec",
				"type": "INT32"
			},
			{
				"name": "release_date",
				"type": "DATE"
			},
			{
				"name": "updated_at",
				"type": "INT96"
			}
		]
	}
}