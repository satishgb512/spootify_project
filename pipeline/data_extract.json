{
	"name": "data_extract",
	"properties": {
		"activities": [
			{
				"name": "extract_wm",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "select last_successful_watermark from dbo.etl_control\nwhere source_db = '@{pipeline().parameters.db_name}'\nand source_schema = '@{pipeline().parameters.schema_name}'\nand source_table = '@{pipeline().parameters.table_name}'",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ms_sql_ds",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "is_wm_entry_available",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "extract_wm",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@equals(activity('extract_wm').output.count, 0)",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "add_wm_entry",
							"type": "Script",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "azuresql_ls",
								"type": "LinkedServiceReference"
							},
							"typeProperties": {
								"scripts": [
									{
										"type": "Query",
										"text": {
											"value": "INSERT INTO dbo.etl_control\n(\n    source_db,\n    source_schema,\n    source_table,\n    watermark_column,\n    last_successful_watermark\n)\nVALUES\n(\n    '@{pipeline().parameters.db_name}',\n    '@{pipeline().parameters.schema_name}',\n    '@{pipeline().parameters.table_name}',\n    '@{pipeline().parameters.update_col}',\n    '1991-01-01 00:00:00'\n);",
											"type": "Expression"
										}
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						}
					]
				}
			},
			{
				"name": "check_record",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "is_wm_entry_available",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "azuresql_ls",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": {
								"value": "select count(*) as record_count\nfrom @{pipeline().parameters.db_name}.@{pipeline().parameters.schema_name}.@{pipeline().parameters.table_name}",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
			{
				"name": "extract_data",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "check_record",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@greater(activity('check_record').output.resultSets[0].rows[0].record_count,0)",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "load_data",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"sqlReaderQuery": {
										"value": "@concat(\n    'SELECT * FROM ',\n    pipeline().parameters.db_name,\n    '.',\n    pipeline().parameters.schema_name,\n    '.',\n    pipeline().parameters.table_name,\n    ' WHERE ',\n    pipeline().parameters.update_col,\n    ' > ''',\n    activity('extract_wm').output.value[0].last_successful_watermark,\n    ''''\n)",
										"type": "Expression"
									},
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"sink": {
									"type": "ParquetSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings",
										"copyBehavior": "FlattenHierarchy"
									},
									"formatSettings": {
										"type": "ParquetWriteSettings"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "ms_sql_ds",
									"type": "DatasetReference"
								}
							],
							"outputs": [
								{
									"referenceName": "ds_parquet_load",
									"type": "DatasetReference",
									"parameters": {
										"table_nm": {
											"value": "@pipeline().parameters.table_name",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			}
		],
		"parameters": {
			"db_name": {
				"type": "string",
				"defaultValue": "spootifydb"
			},
			"schema_name": {
				"type": "string",
				"defaultValue": "dbo"
			},
			"table_name": {
				"type": "string",
				"defaultValue": "DimArtist"
			},
			"update_col": {
				"type": "string",
				"defaultValue": "updated_at"
			}
		},
		"annotations": []
	}
}